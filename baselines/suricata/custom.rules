# Suricata equivalents of our StaticRuleEngine thresholds (Suricata has no "distinct ports" primitive, so the
# port-scan rule has no exact counterpart; ET Open's scan signatures are evaluated separately).
alert tcp any any -> any any (msg:"CUSTOM SYN flood per source"; flags:S; threshold: type threshold, track by_src, count 100, seconds 1; classtype:attempted-dos; sid:9000001; rev:1;)
alert icmp any any -> any any (msg:"CUSTOM ICMP flood per source"; threshold: type threshold, track by_src, count 100, seconds 1; classtype:attempted-dos; sid:9000002; rev:1;)
alert tcp any any -> $HOME_NET 1:1023 (msg:"CUSTOM victim packet flood"; threshold: type threshold, track by_dst, count 400, seconds 1; classtype:attempted-dos; sid:9000003; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"CUSTOM victim connection flood"; flags:S; threshold: type threshold, track by_dst, count 32, seconds 1; classtype:attempted-dos; sid:9000004; rev:1;)
